{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 6am on friday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "@astrojs/solid-js は astro への peer を持たないため、別々に上げると astro だけ進んだ状態を機械が止められない",
      "matchPackageNames": ["astro", "@astrojs/markdown-remark", "@astrojs/solid-js"],
      "matchUpdateTypes": ["major"],
      "groupName": "astro"
    },
    {
      "matchPackageNames": ["node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "groupName": "node"
    }
  ]
}
