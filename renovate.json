{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 6am on friday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "astro とメジャーが揃って動くため別々に上げると壊れる。markdown-remark は peer で止まるが @astrojs/solid-js は止まらない",
      "matchPackageNames": ["astro", "@astrojs/markdown-remark", "@astrojs/solid-js"],
      "matchUpdateTypes": ["major"],
      "groupName": "astro"
    },
    {
      "matchPackageNames": ["node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "groupName": "node"
    }
  ]
}
