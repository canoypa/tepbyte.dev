{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "group:allNonMajor"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 6am on friday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "peer が固定版指定なので astro と markdown-remark は必ず同時に上げる",
      "matchPackageNames": ["astro", "@astrojs/markdown-remark"],
      "matchUpdateTypes": ["major"],
      "groupName": "astro"
    },
    {
      "description": "pnpm は mise.toml と packageManager の両方に出るので必ず同時に上げる",
      "matchPackageNames": ["pnpm"],
      "matchUpdateTypes": ["major"],
      "groupName": "pnpm"
    },
    {
      "description": "型定義はランタイムに揃える。上げるならセットで、判断はダッシュボードから",
      "matchPackageNames": ["node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "groupName": "node",
      "dependencyDashboardApproval": true
    },
    {
      "description": "TypeScript 7 は @astrojs/language-server が未対応。ダッシュボードから作って CI に判定させる",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
