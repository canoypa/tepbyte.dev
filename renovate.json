{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "group:allNonMajor"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 6am on friday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "astro が @astrojs/markdown-remark に固定版の peer を持つため、major を同じ PR にまとめる",
      "matchPackageNames": ["astro", "@astrojs/markdown-remark"],
      "matchUpdateTypes": ["major"],
      "groupName": "astro"
    },
    {
      "description": "pnpm が mise.toml と packageManager の二箇所にあるため、major を同じ PR にまとめる",
      "matchPackageNames": ["pnpm"],
      "matchUpdateTypes": ["major"],
      "groupName": "pnpm"
    },
    {
      "description": "node と @types/node が mise.toml・engines・devDependencies に分かれているため、major を同じ PR にまとめる",
      "matchPackageNames": ["node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "groupName": "node"
    },
    {
      "description": "typescript 7 に @astrojs/check が未対応のため、major はダッシュボードの承認を経て作成する",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
