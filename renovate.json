{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":semanticCommitTypeAll(chore)"
  ],
  "semanticCommits": "enabled",
  "timezone": "Asia/Tokyo",
  "schedule": ["before 6am on friday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "3 つはメジャーが揃って動く。ずれても install は成功するので、別々に上げると気づけない",
      "matchPackageNames": ["astro", "@astrojs/markdown-remark", "@astrojs/solid-js"],
      "matchUpdateTypes": ["major"],
      "groupName": "astro"
    },
    {
      "description": "どちらも versioning: node で LTS 系列しか提案されない（@types/node は workarounds:typesNodeVersioning による）。ここは同じ PR に入れるだけ",
      "matchPackageNames": ["node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "groupName": "node"
    }
  ]
}
