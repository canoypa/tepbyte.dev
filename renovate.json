{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "group:allNonMajor"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 6am on friday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "固定版の peer で結ばれている",
      "matchPackageNames": ["astro", "@astrojs/markdown-remark"],
      "matchUpdateTypes": ["major"],
      "groupName": "astro"
    },
    {
      "description": "mise.toml と packageManager にある",
      "matchPackageNames": ["pnpm"],
      "matchUpdateTypes": ["major"],
      "groupName": "pnpm"
    },
    {
      "description": "mise.toml と engines と devDependencies にある",
      "matchPackageNames": ["node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "groupName": "node"
    }
  ]
}
