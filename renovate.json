{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "group:allNonMajor"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 6am on friday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "peer が固定版指定なので astro と markdown-remark は必ず同時に上げる",
      "matchPackageNames": ["astro", "@astrojs/markdown-remark"],
      "matchUpdateTypes": ["major"],
      "groupName": "astro"
    },
    {
      "description": "pnpm は mise.toml と packageManager の両方に出るので必ず同時に上げる",
      "matchPackageNames": ["pnpm"],
      "matchUpdateTypes": ["major"],
      "groupName": "pnpm"
    },
    {
      "description": "Node の LTS 追従は config:recommended の workarounds:typesNodeVersioning が既にやっている。ここは次の LTS に移る時に mise.toml・engines・型定義を 1 本の PR で見るためだけ",
      "matchPackageNames": ["node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "groupName": "node"
    },
    {
      "description": "TypeScript 7 は @astrojs/language-server が未対応。毎週赤い PR を立てないようダッシュボード経由にする",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
