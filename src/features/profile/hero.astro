---
import type { CollectionEntry } from 'astro:content'
import Image from '~/components/image/image.astro'
import { resolveImage } from '~/components/image/resolve_image'
import { css } from '~pandacss/css'
import { flex } from '~pandacss/patterns'
import ProfileLink from './profile_link.astro'

type Props = {
  profile: CollectionEntry<'profile'>['data']
}

const { profile } = Astro.props

const avatar = await resolveImage({
  src: profile.avatar,
  width: 192,
  height: 192,
})

const styles = {
  root: css({
    display: 'grid',
    gridTemplate: 'auto / auto 1fr',
    gridTemplateAreas: {
      base: '"photo name" "info info"',
      mdExpanded: '"photo name" "photo info"',
    },
    alignItems: 'center',
    columnGap: 'md.space300',
    rowGap: 'md.space100',
  }),
  avatar: css({
    gridArea: 'photo',

    width: { base: 96, mdExpanded: 192 },
    height: { base: 96, mdExpanded: 192 },
    rounded: 'md.full',
  }),
  name: css({
    gridArea: 'name',

    textStyle: 'md.emphasized.display-large',
  }),
  info: flex({
    gridArea: 'info',

    direction: 'column',
    rowGap: 'md.space300',
    textStyle: 'md.headline-small',
  }),
}
---

<div class:list={styles.root}>
  <Image
    {...avatar.attributes}
    alt=""
    placeholder={avatar.placeholder}
    class:list={styles.avatar}
  />
  <h1 class:list={styles.name}>{profile.name}</h1>
  <div class:list={styles.info}>
    <span>{profile.subhead}</span>
    <ProfileLink links={profile.links} />
  </div>
</div>
