---
import { css } from '~pandacss/css'

const style = {
  root: css({
    lineHeight: '1.8',

    '& :where(p,ul,ol,blockquote,table,hr)': {
      marginBlock: '1rem',

      '&:first-child': {
        marginTop: '0',
      },
      '&:last-child': {
        marginBottom: '0',
      },
    },

    '& :where(h1,h2,h3,h4,h5,h6)': {
      marginTop: '3rem',
      marginBottom: '1rem',

      '&:first-child': {
        marginTop: '0',
      },
      '&:last-child': {
        marginBottom: '0',
      },
    },

    '& hr': {
      borderColor: { base: 'dark.outline', _osLight: 'light.outline' },
    },

    '& a': {
      color: { base: 'dark.info', _osLight: 'light.info' },
      textDecoration: 'underline',
      textDecorationColor: { base: 'dark.info/60', _osLight: 'light.info/60' },
    },

    '& h1': {
      textStyle: 'headline-large',
      fontFamily: 'comfortaa',
    },
    '& h2': {
      textStyle: 'headline-medium',
      fontFamily: 'comfortaa',
    },
    '& h3': {
      textStyle: 'headline-small',
      fontFamily: 'comfortaa',
    },
    '& h4': {
      textStyle: 'title-large',
      fontFamily: 'comfortaa',
    },
    '& h5': {
      textStyle: 'title-medium',
      fontFamily: 'comfortaa',
    },
    '& h6': {
      textStyle: 'title-small',
      fontFamily: 'comfortaa',
    },

    '& img': {
      borderRadius: 'medium',
      marginInline: 'auto',

      // 縦長画像を 80vh で頭打ちにする。height 軸で clamp すると幅が属性値の
      // まま残って歪み、width:auto で回避すると読込前に寸法が 0 に潰れて CLS
      // が出るため、cap を width 軸へ写し width/height 属性から算出する。
      // attr() 未対応ブラウザではこの宣言ごと無効になり、preflight の
      // max-width:100%（cap なし・比率は保持）にフォールバックする。
      maxWidth:
        'min(100%, calc(80vh * attr(width type(<number>)) / attr(height type(<number>))))',
    },

    '& blockquote': {
      borderLeft: '4px solid',
      borderColor: { base: 'dark.outline', _osLight: 'light.outline' },
      padding: '0.5rem 1rem',
    },

    '& sup>a': {
      '&::before': {
        content: '"["',
      },
      '&::after': {
        content: '"]"',
      },
    },

    '& table': {
      width: '100%',

      '& :where(th,td)': {
        padding: '0.5rem 1rem',
        border: '1px solid',
        borderColor: {
          base: 'dark.outline-variant',
          _osLight: 'light.outline-variant',
        },
      },
    },

    '& :where(ul,ol)': {
      paddingLeft: '1.5rem',

      '& :where(ul,ol)': {
        marginTop: '0',
      },
    },
    '& ul': {
      listStyleType: 'disc',
      '& ul': {
        listStyleType: 'circle',
        '& ul': {
          listStyleType: 'square',
        },
      },
    },
    '& ol': {
      listStyleType: 'decimal',
      '& ol': {
        listStyleType: 'lower-alpha',
        '& ol': {
          listStyleType: 'lower-roman',
        },
      },
    },

    '& :not(pre) code': {
      paddingInline: '0.2rem',
      borderRadius: 'extra-small',
      backgroundColor: {
        base: 'dark.surface-variant',
        _osLight: 'light.surface-variant',
      },
      textStyle: 'body-medium',
    },

    '& kbd': {
      padding: '0.1rem 0.2rem',
      border: '1px solid',
      borderBottom: '2px solid',
      borderColor: { base: 'dark.outline', _osLight: 'light.outline' },
      borderRadius: 'extra-small',
      textStyle: 'body-medium',
    },

    '& .astro-code': {
      padding: '1rem',
      borderRadius: 'small',
    },

    '& mark': {
      backgroundColor: {
        base: 'dark.warning-container/80',
        _osLight: 'light.warning-container/80',
      },
    },

    '& .footnotes': {
      marginTop: '3rem',
      paddingTop: '1rem',
      borderTop: '1px solid',
      borderColor: {
        base: 'dark.outline-variant',
        _osLight: 'light.outline-variant',
      },
      textStyle: 'body-medium',
      color: {
        base: 'dark.on-surface-variant',
        _osLight: 'light.on-surface-variant',
      },

      '& ol': {
        marginBlock: 0,
      },

      '& [data-footnote-backref]': {
        // ↩ が絵文字フォントにフォールバックするのを防ぐ
        fontFamily:
          'ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif',
      },
    },
  }),
}
---

<div class:list={style.root}>
  <slot />
</div>
