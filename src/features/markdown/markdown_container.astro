---
import { css } from '~pandacss/css'

const style = {
  root: css({
    lineHeight: '1.8',

    '& :where(p,ul,ol,blockquote,table,hr)': {
      marginBlock: '1rem',

      '&:first-child': {
        marginTop: '0',
      },
      '&:last-child': {
        marginBottom: '0',
      },
    },

    '& :where(h1,h2,h3,h4,h5,h6)': {
      marginTop: '3rem',
      marginBottom: '1rem',

      '&:first-child': {
        marginTop: '0',
      },
      '&:last-child': {
        marginBottom: '0',
      },
    },

    '& hr': {
      borderColor: 'md.outline',
    },

    '& a': {
      color: 'md.info',
      textDecoration: 'underline',
      textDecorationColor: 'md.info/60',
    },

    '& h1': {
      textStyle: 'md.headline-large',
      fontFamily: 'comfortaa',
    },
    '& h2': {
      textStyle: 'md.headline-medium',
      fontFamily: 'comfortaa',
    },
    '& h3': {
      textStyle: 'md.headline-small',
      fontFamily: 'comfortaa',
    },
    '& h4': {
      textStyle: 'md.title-large',
      fontFamily: 'comfortaa',
    },
    '& h5': {
      textStyle: 'md.title-medium',
      fontFamily: 'comfortaa',
    },
    '& h6': {
      textStyle: 'md.title-small',
      fontFamily: 'comfortaa',
    },

    '& img': {
      borderRadius: 'md.medium',
      marginInline: 'auto',
      // 高さ cap を幅側で算出。max-height だと width:auto 必須→未ロード時サイズ 0(CLS)。
      maxWidth:
        'min(100%, calc(80vh * attr(width type(<number>)) / attr(height type(<number>))))',
    },

    '& blockquote': {
      borderLeft: '4px solid',
      borderColor: 'md.outline',
      padding: '0.5rem 1rem',
    },

    '& sup>a': {
      '&::before': {
        content: '"["',
      },
      '&::after': {
        content: '"]"',
      },
    },

    '& table': {
      width: '100%',

      '& :where(th,td)': {
        padding: '0.5rem 1rem',
        border: '1px solid',
        borderColor: 'md.outline-variant',
      },
    },

    '& :where(ul,ol)': {
      paddingLeft: '1.5rem',

      '& :where(ul,ol)': {
        marginTop: '0',
      },
    },
    '& ul': {
      listStyleType: 'disc',
      '& ul': {
        listStyleType: 'circle',
        '& ul': {
          listStyleType: 'square',
        },
      },
    },
    '& ol': {
      listStyleType: 'decimal',
      '& ol': {
        listStyleType: 'lower-alpha',
        '& ol': {
          listStyleType: 'lower-roman',
        },
      },
    },

    '& :not(pre) code': {
      paddingInline: '0.2rem',
      borderRadius: 'md.extra-small',
      backgroundColor: 'md.surface-variant',
      textStyle: 'md.body-medium',
    },

    '& kbd': {
      padding: '0.1rem 0.2rem',
      border: '1px solid',
      borderBottom: '2px solid',
      borderColor: 'md.outline',
      borderRadius: 'md.extra-small',
      textStyle: 'md.body-medium',
    },

    '& .astro-code': {
      padding: '1rem',
      borderRadius: 'md.small',
    },

    '& mark': {
      backgroundColor: 'md.warning-container/80',
    },

    '& .footnotes': {
      marginTop: '3rem',
      paddingTop: '1rem',
      borderTop: '1px solid',
      borderColor: 'md.outline-variant',
      textStyle: 'md.body-medium',
      color: 'md.on-surface-variant',

      '& ol': {
        marginBlock: 0,
      },

      '& [data-footnote-backref]': {
        // ↩ が絵文字フォントにフォールバックするのを防ぐ
        fontFamily:
          'ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif',
      },
    },
  }),
}
---

<div class:list={style.root}>
  <slot />
</div>
