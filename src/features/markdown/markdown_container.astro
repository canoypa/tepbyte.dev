---
import { css } from '~pandacss/css'

const style = {
  root: css({
    lineHeight: '1.8',

    '& :where(p,ul,ol,blockquote,table,hr)': {
      marginBlock: '1rem',

      '&:first-child': {
        marginTop: '0',
      },
      '&:last-child': {
        marginBottom: '0',
      },
    },

    // 見出しは本文よりも上の余白を広く取り、セクションの切れ目を作る
    // (下の余白は本文と近いまま = 見出しは直後の段落と一体に見える)
    '& :where(h1,h2,h3,h4,h5,h6)': {
      marginTop: '3rem',
      marginBottom: '1rem',
      fontFamily: 'comfortaa',

      '&:first-child': {
        marginTop: '0',
      },
      '&:last-child': {
        marginBottom: '0',
      },
    },

    '& hr': {
      borderColor: { base: 'dark.outline', _osLight: 'light.outline' },
    },

    '& a': {
      color: { base: 'dark.info', _osLight: 'light.info' },
      textDecoration: 'underline',
      textDecorationColor: { base: 'dark.info/60', _osLight: 'light.info/60' },
    },

    '& h1': {
      textStyle: 'headline-large',
    },
    '& h2': {
      textStyle: 'headline-medium',
    },
    '& h3': {
      textStyle: 'headline-small',
    },
    '& h4': {
      textStyle: 'title-large',
    },
    '& h5': {
      textStyle: 'title-medium',
    },
    '& h6': {
      textStyle: 'title-small',
    },

    '& img': {
      borderRadius: 'medium',
      // 記事幅いっぱいに広がると縦長のスクリーンショットが大きくなりすぎるため、
      // 高さで頭打ちにする（横長の写真は幅制約(reset由来)側で収まるので影響しない）
      maxHeight: '70vh',
      // width が auto でないと、max-width と max-height が独立にクランプされて
      // アスペクト比が崩れる（縦長画像が横に引き伸ばされる）ため明示する
      width: 'auto',
      // maxHeight で縮んだ画像は記事幅に満たなくなるため、中央寄せする
      marginInline: 'auto',
    },

    '& blockquote': {
      borderLeft: '4px solid',
      borderColor: { base: 'dark.outline', _osLight: 'light.outline' },
      padding: '0.5rem 1rem',
    },

    '& sup>a': {
      '&::before': {
        content: '"["',
      },
      '&::after': {
        content: '"]"',
      },
    },

    '& table': {
      width: '100%',

      '& :where(th,td)': {
        padding: '0.5rem 1rem',
        border: '1px solid',
        borderColor: {
          base: 'dark.outline-variant',
          _osLight: 'light.outline-variant',
        },
      },
    },

    '& :where(ul,ol)': {
      paddingLeft: '1.5rem',

      '& :where(ul,ol)': {
        marginTop: '0',
      },
    },
    '& ul': {
      listStyleType: 'disc',
      '& ul': {
        listStyleType: 'circle',
        '& ul': {
          listStyleType: 'square',
        },
      },
    },
    '& ol': {
      listStyleType: 'decimal',
      '& ol': {
        listStyleType: 'lower-alpha',
        '& ol': {
          listStyleType: 'lower-roman',
        },
      },
    },

    '& :not(pre) code': {
      paddingInline: '0.2rem',
      borderRadius: 'extra-small',
      backgroundColor: {
        base: 'dark.surface-variant',
        _osLight: 'light.surface-variant',
      },
      textStyle: 'body-medium',
    },

    '& kbd': {
      padding: '0.1rem 0.2rem',
      border: '1px solid',
      borderBottom: '2px solid',
      borderColor: { base: 'dark.outline', _osLight: 'light.outline' },
      borderRadius: 'extra-small',
      textStyle: 'body-medium',
    },

    '& .astro-code': {
      padding: '1rem',
      borderRadius: 'small',
    },

    '& mark': {
      backgroundColor: {
        base: 'dark.warning-container/80',
        _osLight: 'light.warning-container/80',
      },
    },

    // 独立した箱で囲むのではなく、上の罫線 1 本だけで本文と区切る
    // (blockquote や table と同じく、罫線ベースの控えめな装飾に揃える)
    '& .footnotes': {
      marginTop: '3rem',
      paddingTop: '1rem',
      borderTop: '1px solid',
      borderColor: { base: 'dark.outline-variant', _osLight: 'light.outline-variant' },
      textStyle: 'body-medium',
      color: { base: 'dark.on-surface-variant', _osLight: 'light.on-surface-variant' },

      '& ol': {
        marginBlock: 0,
      },

      // 戻るリンクの "↩"(U+21A9) はサイトの Web フォントに字形が無く、
      // システムのカラー絵文字フォントへフォールバックして丸背景の絵文字風に描画される。
      // 絵文字対応フォントを含まないスタックを明示し、モノクロの記号として描画させる
      '& [data-footnote-backref]': {
        fontFamily:
          'ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif',
      },
    },
  }),
}
---

<div class:list={style.root}>
  <slot />
</div>
