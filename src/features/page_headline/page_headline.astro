---
import { css } from '~pandacss/css'
import { flex } from '~pandacss/patterns'

const styles = {
  root: flex({ direction: 'column', rowGap: 16 }),
  title: css({
    textStyle: {
      mdExpandedDown: 'md.display-medium',
      mdExpanded: 'md.display-large',
    },
    fontFamily: 'comfortaa',
    fontWeight: 'bold',
  }),
  subhead: css({
    textStyle: {
      mdExpandedDown: 'md.title-medium',
      mdExpanded: 'md.title-large',
    },
    fontFamily: 'comfortaa',
  }),
}

type Props = {
  title: string
  subhead?: string
}

const { title, subhead } = Astro.props
---

<div class:list={styles.root}>
  <h1 class:list={styles.title}>{title}</h1>
  {subhead && <p class:list={styles.subhead}>{subhead}</p>}
</div>
