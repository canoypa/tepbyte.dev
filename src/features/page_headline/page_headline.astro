---
import { css } from '~pandacss/css'
import { flex } from '~pandacss/patterns'

const styles = {
  root: flex({ direction: 'column', rowGap: 'md.space200' }),
  title: css({
    textStyle: {
      mdExpandedDown: 'md.emphasized.display-medium',
      mdExpanded: 'md.emphasized.display-large',
    },
  }),
  subhead: css({
    textStyle: {
      mdExpandedDown: 'md.title-medium',
      mdExpanded: 'md.title-large',
    },
    fontFamily: 'comfortaa',
  }),
}

type Props = {
  title: string
  subhead?: string
  lang?: string
}

const { title, subhead, lang } = Astro.props
---

<hgroup class:list={styles.root} lang={lang}>
  <h1 class:list={styles.title}>{title}</h1>
  {subhead && <p class:list={styles.subhead}>{subhead}</p>}
</hgroup>
