---
import type { CollectionEntry } from 'astro:content'
import Image from '~/components/image/image.astro'
import { resolveImage } from '~/components/image/resolve_image'
import Lightbox from '~/components/lightbox/lightbox.astro'
import { lightboxSizes } from '~/components/lightbox/lightbox_sizes'
import LightboxTrigger from '~/components/lightbox/lightbox_trigger.astro'
import { css } from '~pandacss/css'

type Props = {
  images: CollectionEntry<'product'>['data']['images']
}

const { images } = Astro.props

const screenshots = await Promise.all(
  images.map(async (src, index) => ({
    id: `screenshot-${index}`,
    width: src.width,
    height: src.height,
    ...(await resolveImage({ src, width: src.width, height: src.height })),
  })),
)

const styles = {
  root: css({
    display: 'flex',
    gap: 16,
    overflowX: 'auto',

    scrollbarWidth: 'none',
    _scrollbar: { display: 'none' },
  }),
  image: css({
    // width 属性が presentational hint として効くので、明示的に打ち消して
    // height と固有比から決めさせる。max-width: fit-content で打ち消すと、
    // Safari では固有サイズの確定に間に合わなかったときに固有幅へ落ちる
    width: 'auto',
    maxWidth: 'none',
    height: { base: 216, md: 288 },
    objectFit: 'cover',
  }),
  trigger: css({ rounded: 'extra-large' }),
}
---

<div class:list={styles.root}>
  {
    screenshots.map(({ id, width, height, attributes, placeholder }) => (
      <>
        <LightboxTrigger for={id} class:list={styles.trigger}>
          <Image
            {...attributes}
            alt="スクリーンショットを拡大表示"
            placeholder={placeholder}
            class:list={styles.image}
          />
        </LightboxTrigger>
        <Lightbox id={id} width={width} height={height}>
          <Image
            {...attributes}
            sizes={lightboxSizes(width, height)}
            alt=""
            placeholder={placeholder}
          />
        </Lightbox>
      </>
    ))
  }
</div>
