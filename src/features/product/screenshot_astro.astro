---
import type { CollectionEntry } from 'astro:content'
import Image from '~/components/image/image.astro'
import { css } from '~pandacss/css'

type Props = {
  images: CollectionEntry<'product'>['data']['images']
}

const { images } = Astro.props

const styles = {
  root: css({
    display: 'flex',
    gap: 16,
    overflowX: 'auto',

    scrollbarWidth: 'none',
    _scrollbar: { display: 'none' },
  }),
  image: css({
    // width 属性が presentational hint として効くので、明示的に打ち消して
    // height と固有比から決めさせる。max-width: fit-content で打ち消すと、
    // Safari では固有サイズの確定に間に合わなかったときに固有幅へ落ちる
    width: 'auto',
    maxWidth: 'none',
    height: { base: 216, md: 288 },
    rounded: 'extra-large',
    objectFit: 'cover',
  }),
}
---

<div class:list={styles.root}>
  {
    images.map((v) => (
      <Image
        src={v}
        alt=""
        width={v.width}
        height={v.height}
        class:list={styles.image}
        lightbox
      />
    ))
  }
</div>
