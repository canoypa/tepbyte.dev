---
import type { CollectionEntry } from 'astro:content'
import ArticleCard from '~/components/article_card.astro'
import { flex } from '~pandacss/patterns'

const styles = {
  root: flex({
    direction: 'column',
    gap: { base: 'md.space100', mdExpanded: 'md.space200' },
  }),
}

type Props = {
  items: CollectionEntry<'product'>[]
}

const { items } = Astro.props
---

<ul class:list={styles.root}>
  {
    items.map((item) => (
      <li>
        <ArticleCard
          date={item.data.publishedAt}
          link={`/products/${item.id}`}
          title={item.data.title}
          subhead={item.data.subhead}
        />
      </li>
    ))
  }
</ul>
