---
import ArticleCardList from '~/components/article_card_list.astro'
import type { Article } from '~/core/article/article'

type Props = {
  items: Article[]
  itemHeadingLevel: 2 | 3
}

const { items, itemHeadingLevel } = Astro.props
---

<ArticleCardList
  items={items.map((item) => ({
    date: new Date(item.publishedAt),
    // Zenn の公開日時は時刻まである
    datetime: new Date(item.publishedAt).toISOString(),
    link: item.url,
    title: item.title,
    subhead: item.excerpt,
  }))}
  clampSubhead
  itemHeadingLevel={itemHeadingLevel}
/>
