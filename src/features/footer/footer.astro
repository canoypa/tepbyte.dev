---
import StyledLink from '~/components/styled_link/styled_link.astro'
import { css } from '~pandacss/css'

const styles = {
  root: css({
    paddingX: { mdMedium: 'md.space300' },
    paddingY: { mdMediumDown: 'md.space400', mdMedium: 'md.space600' },
    borderTopWidth: 1,
    borderTopStyle: 'solid',
    borderTopColor: 'md.outline-variant',
    color: 'md.on-surface-variant',
    textStyle: 'md.body-small',
  }),
}
---

<footer class:list={styles.root}>
  <span>このサイトは Google Analytics を使用しています。詳しくは </span>
  <StyledLink href="https://policies.google.com/technologies/partner-sites">
    Google のサービスを使用するサイトやアプリから収集した情報の Google
    による使用
  </StyledLink>
  <span> をご覧ください。</span>
</footer>
