---
import IconTag from '~/components/icons/tag.astro'
import { css } from '~pandacss/css'

const styles = {
  root: css({
    display: 'flex',
    alignItems: 'center',
    columnGap: 2,
    height: 24,
    paddingLeft: 6,
    paddingRight: 8,
    rounded: 'md.full',
    backgroundColor: 'md.secondary-container',
    color: 'md.on-secondary-container',
    fill: 'md.on-secondary-container',
    textStyle: 'md.label-medium',
    fontFamily: 'comfortaa',
  }),
}
---

<span class:list={styles.root}>
  <IconTag width={16} height={16} />
  <slot />
</span>
