---
import { getImage } from 'astro:assets'
import { getEntry } from 'astro:content'
import { SEO } from 'astro-seo'

type Props = {
  title?: string
  description?: string

  openGraph?: {
    basic?: {
      title?: string
      type?: string
      image?: ImageMetadata
      url?: URL | string
    }
    optional?: {
      description?: string
    }
  }

  canonical?: URL | string | null

  noindex?: boolean
  nofollow?: boolean
}

const props = Astro.props

const siteName = 'Tepbyte'

const title = props.title
const description = props.description || "Cano's portfolio site."

const profile = await getEntry('profile', 'canoypa')
if (!profile) throw new Error('profile/canoypa が見つからない')

// og:image は原寸のアセットを指さないよう縮小したうえで、クローラが
// 解決できるよう絶対 URL にする
const ogImageSrc = (
  await getImage({
    src: props.openGraph?.basic?.image ?? profile.data.cover,
    width: 1200,
    // webp はクローラ側の対応にばらつきがあるため jpeg で固定する
    format: 'jpeg',
  })
).src

const ogImage = new URL(ogImageSrc, Astro.site).toString()
---

<SEO
  title={title}
  titleTemplate={`%s - ${siteName}`}
  titleDefault={siteName}
  description={description}
  openGraph={{
    basic: {
      type: "website",
      title: title || siteName,
      ...props.openGraph?.basic,
      image: ogImage,
    },
    optional: {
      siteName: siteName,
      description: description,
      ...props.openGraph?.optional,
    },
  }}
  canonical={props.canonical}
  noindex={props.noindex}
  nofollow={props.nofollow}
/>
