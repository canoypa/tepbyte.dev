---
import Image from '~/components/image/image.astro'
import StyledLink from '~/components/styled_link/styled_link.astro'
import type { UnsplashAttribution } from '~/core/image/unsplash'
import { css } from '~pandacss/css'
import { flex } from '~pandacss/patterns'

type Props = {
  image: ImageMetadata
  attribution?: UnsplashAttribution
}

const { image, attribution } = Astro.props

const styles = {
  root: flex({ direction: 'column', rowGap: 8 }),
  img: css({
    width: '100%',
    height: { base: 216, md: 288 },
    rounded: 'extra-large',
    objectFit: 'cover',
  }),
  attribution: css({
    textStyle: 'label-medium',
    fontFamily: 'comfortaa',
    fontStyle: 'italic',
  }),
}
---

<figure class:list={styles.root}>
  <Image src={image} alt="" width={1680} class:list={styles.img} />
  {
    attribution && (
      <figcaption>
        <small class:list={styles.attribution}>
          <span>Photo by </span>
          <StyledLink href={attribution.authorUrl}>
            {attribution.authorName}
          </StyledLink>
          <span> on </span>
          <StyledLink href={attribution.siteUrl}>
            {attribution.siteName}
          </StyledLink>
        </small>
      </figcaption>
    )
  }
</figure>
