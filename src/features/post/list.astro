---
import type { CollectionEntry } from 'astro:content'
import ArticleCardList from '~/components/article_card_list.astro'
import { toJstDateString } from '~/core/date'

type Props = {
  items: CollectionEntry<'post'>[]
  itemHeadingLevel: 2 | 3
}

const { items, itemHeadingLevel } = Astro.props
---

<ArticleCardList
  items={items.map((item) => ({
    date: item.data.publishedAt,
    datetime: toJstDateString(item.data.publishedAt),
    link: `/posts/${item.id}`,
    title: item.data.title,
    subhead: item.data.subhead,
  }))}
  itemHeadingLevel={itemHeadingLevel}
/>
