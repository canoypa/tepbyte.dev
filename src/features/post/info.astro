---
import type { CollectionEntry } from 'astro:content'
import { toJstDateString } from '~/core/date'
import { css } from '~pandacss/css'
import { flex } from '~pandacss/patterns'
import PageHeadline from '../page_headline/page_headline.astro'
import Thumbnail from './thumbnail.astro'

const styles = {
  root: flex({ direction: 'column', gap: 'md.space400' }),
  dateTime: css({ textStyle: 'md.body-medium', fontFamily: 'comfortaa' }),
}

type Props = {
  post: CollectionEntry<'post'>['data']
}

const { post } = Astro.props

const dateFormatter = Intl.DateTimeFormat('en-us', {
  dateStyle: 'long',
  timeZone: 'Asia/Tokyo',
})
---

<header class:list={styles.root}>
  <Thumbnail image={post.image} attribution={post.attribution} />
  <PageHeadline title={post.title} subhead={post.subhead} />
  <div class:list={styles.dateTime}>
    <time datetime={toJstDateString(post.publishedAt)}>
      {dateFormatter.format(post.publishedAt)}
    </time>
    {
      post.updatedAt && (
        <>
          <span> - </span>
          <time datetime={toJstDateString(post.updatedAt)}>
            Updated {dateFormatter.format(post.updatedAt)}
          </time>
        </>
      )
    }
  </div>
</header>
