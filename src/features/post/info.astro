---
import type { CollectionEntry } from 'astro:content'
import { css } from '~pandacss/css'
import { flex } from '~pandacss/patterns'
import PageHeadline from '../page_headline/page_headline.astro'
import Thumbnail from './thumbnail.astro'

const styles = {
  root: flex({ direction: 'column', gap: 'md.space400' }),
  dateTime: css({ textStyle: 'md.body-medium', fontFamily: 'comfortaa' }),
}

type Props = {
  post: CollectionEntry<'post'>['data']
}

const { post } = Astro.props

const dateFormatter = Intl.DateTimeFormat('en-us', { dateStyle: 'long' })
// frontmatter は日付だけで、時刻は UTC の 0 時として読まれる。datetime も日付だけにする
const toDatetime = (date: Date) => date.toISOString().slice(0, 10)

const publishedAt = dateFormatter.format(post.publishedAt)
const updatedAt = post.updatedAt && dateFormatter.format(post.updatedAt)
---

<header class:list={styles.root}>
  <Thumbnail image={post.image} attribution={post.attribution} />
  <PageHeadline title={post.title} subhead={post.subhead} />
  <div class:list={styles.dateTime}>
    <time datetime={toDatetime(post.publishedAt)}>{publishedAt}</time>
    {
      post.updatedAt && updatedAt && (
        <>
          <span> - </span>
          <time datetime={toDatetime(post.updatedAt)}>
            Updated {updatedAt}
          </time>
        </>
      )
    }
  </div>
</header>
