---
import Button from '~/components/button/button.astro'
import { css } from '~pandacss/css'
import { flex } from '~pandacss/patterns'

type Props = {
  title: string
  moreHref: string
}

const { title, moreHref } = Astro.props

const styles = {
  root: flex({ direction: 'column', rowGap: 'md.space400' }),
  title: css({
    textStyle: 'md.emphasized.display-small',
  }),
  actions: flex({
    direction: 'row',
    alignItems: 'center',
    justifyContent: 'space-between',
    columnGap: 'md.space300',
  }),
}
---

<section class:list={styles.root}>
  <h2 class:list={styles.title}>{title}</h2>
  <slot />
  <div class:list={styles.actions}>
    <Button as="a" href={moreHref}>すべて見る</Button>
    <slot name="actions-trailing" />
  </div>
</section>
