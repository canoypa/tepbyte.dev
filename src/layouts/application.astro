---
import { Font } from 'astro:assets'
import Footer from '~/features/footer/footer.astro'

import '~/styles/globals.css'
import { css } from '~pandacss/css'

const styles = {
  body: css({
    display: 'grid',
    gridTemplateColumns: {
      smDown:
        '[full-start] 16px [content-start] minmax(0, 1fr) [content-end] 16px [full-end]',
      smToMd:
        '[full-start] 32px [content-start] minmax(0, 1fr) [content-end] 32px [full-end]',
      mdToLg:
        '[full-start] minmax(0, 1fr) [content-start] minmax(0, 840px) [content-end] minmax(0, 1fr) [full-end]',
      lgToXl:
        '[full-start] 200px [content-start] minmax(0, 1fr) [content-end] 200px [full-end]',
      xl: '[full-start] minmax(0, 1fr) [content-start] minmax(0, 1040px) [content-end] minmax(0, 1fr) [full-end]',
    },
    gridTemplateRows: '1fr auto',
    rowGap: 128,

    '& > *': { gridColumn: 'content' },
  }),
  main: css({
    display: 'flex',
    flexDirection: 'column',
    gap: 64,
    marginTop: 64, // 下端は rowGap 側
  }),
}
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" sizes="any" />
    <link
      rel="apple-touch-icon"
      href="/apple-icon.png"
      type="image/png"
      sizes="180x180"
    />

    <Font cssVariable="--font-comfortaa" preload />
    <Font cssVariable="--font-kosugi-maru" />

    <slot name="head" />

    <script>
      import { init } from "astro/virtual-modules/prefetch.js";
      init({ prefetchAll: true });
    </script>
  </head>
  <body class:list={styles.body}>
    <main class:list={styles.main}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
