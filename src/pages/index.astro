---
import { getCollection, getEntry, render } from 'astro:content'
import StyledLink from '~/components/styled_link/styled_link.astro'
import {
  UNSPLASH_PROFILE_URL,
  UNSPLASH_SITE_URL,
  UNSPLASH_USERNAME,
} from '~/core/image/unsplash'
import HomeSection from '~/features/home_section.astro'
import MarkdownContainer from '~/features/markdown/markdown_container.astro'
import PostList from '~/features/post/list.astro'
import ProductList from '~/features/product/list.astro'
import Hero from '~/features/profile/hero.astro'
import PhotoGallery from '~/features/profile/photo_gallery.astro'
import Seo from '~/features/seo/seo.astro'
import Application from '~/layouts/application.astro'
import { css } from '~pandacss/css'

const entry = await getEntry('profile', 'canoypa')
if (!entry) {
  throw new Error('Profile not found')
}

const { Content } = await render(entry)

const products = (await getCollection('product'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 5)
const posts = (await getCollection('post'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 5)
const photos = (await getCollection('photo'))
  .map((entry) => entry.data)
  .sort((a, b) => Date.parse(b.createdAt) - Date.parse(a.createdAt))
  .slice(0, 6)

const styles = {
  credit: css({ textStyle: 'md.body-small' }),
}
---

<Application>
  <Seo slot="head" />

  <Hero profile={entry.data} />
  <MarkdownContainer>
    <Content />
  </MarkdownContainer>

  <HomeSection title="Products" moreHref="/products">
    <ProductList items={products} />
  </HomeSection>

  <HomeSection title="Posts" moreHref="/posts">
    <PostList items={posts} />
  </HomeSection>

  <HomeSection title="Photos" moreHref={UNSPLASH_PROFILE_URL}>
    <PhotoGallery photos={photos} />
    <span slot="actions-trailing" class:list={styles.credit}>
      <StyledLink href={UNSPLASH_PROFILE_URL}>@{UNSPLASH_USERNAME}</StyledLink> on{" "}
      <StyledLink href={UNSPLASH_SITE_URL}>Unsplash</StyledLink>
    </span>
  </HomeSection>
</Application>
