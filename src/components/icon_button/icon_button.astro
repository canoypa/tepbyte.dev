---
import type { HTMLAttributes } from 'astro/types'
import { css } from '~pandacss/css'
import { token } from '~pandacss/tokens'
import type { SystemStyleObject } from '~pandacss/types'

const styles = {
  root: css.raw({
    position: 'relative',
    display: 'inline-flex',
    alignItems: 'center',
    justifyContent: 'center',
    width: 40,
    height: 40,
    padding: 0,
    background: 'none',
    border: 'none',
    // full（9999px）から補間すると、見た目の半径 20px を切るまで形が変わらない
    rounded: 20,
    cursor: 'pointer',
    fill: 'md.on-surface-variant',
    // 色は effects、形は spatial の spring
    transitionProperty: 'background-color, border-radius',
    transitionDuration: `${token.var('durations.md.spring.fast.effects')}, ${token.var('durations.md.spring.fast.spatial')}`,
    transitionTimingFunction: `${token.var('easings.md.spring.fast.effects')}, ${token.var('easings.md.spring.fast.spatial')}`,

    // 当たり判定は見た目の 40 より広い 48
    _before: {
      content: '""',
      position: 'absolute',
      inset: '-md.space50',
    },

    _hover: {
      backgroundColor: 'md.on-surface-variant/md.hover',
    },
    _focusVisible: {
      backgroundColor: 'md.on-surface-variant/md.focus',
    },
    _active: {
      backgroundColor: 'md.on-surface-variant/md.pressed',
      rounded: 'md.small',
    },
  }),
  icon: css({ width: 24, height: 24 }),
}

type Props = HTMLAttributes<'button'> & {
  /** 既定のスタイルに合成する。同じプロパティは条件ごと置き換わる */
  css?: SystemStyleObject
}

const { type = 'button', class: className, css: style, ...attrs } = Astro.props
---

<button
  type={type}
  {...attrs}
  class:list={[css(styles.root, style), className]}
>
  <span class:list={styles.icon}>
    <slot />
  </span>
</button>
