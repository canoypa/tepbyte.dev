---
import type { HTMLTag, Polymorphic } from 'astro/types'
import { css } from '~pandacss/css'

const styles = {
  root: css({
    display: 'inline-flex',
    alignItems: 'center',
    paddingX: 16,
    height: 32,
    borderWidth: 1,
    borderStyle: 'solid',
    borderColor: 'md.outline',
    rounded: 'md.small',
    textStyle: 'md.label-large',
    fontFamily: 'comfortaa',
    cursor: 'pointer',
    transitionProperty: 'background-color',
    transitionDuration: 'md.medium1',

    backgroundColor: {
      _hover: 'md.primary/md.hover',
      _focusVisible: 'md.primary/md.hover',
    },
  }),
}

type Props<T extends HTMLTag> = Polymorphic<{
  as: T
}>

const { as: Tag = 'span', ...attrs } = Astro.props
---

<Tag {...attrs} class:list={styles.root}>
  <slot />
</Tag>
