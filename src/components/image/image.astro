---
import type { UnresolvedImageTransform } from "astro";
import { getImage } from "astro:assets";
import { blurDataUrlOf } from "~/core/image/types";
import { Image as ImageReact } from "./image";

type Props = UnresolvedImageTransform & {
  lightbox?: boolean;
  /** リモート画像など、src に blurDataUrl が載らない場合に外から渡す */
  blurDataUrl?: string;
};

const { blurDataUrl: givenBlurDataUrl, ...props } = Astro.props;

const image = await getImage(props);

const blurDataUrl = givenBlurDataUrl ?? blurDataUrlOf(image.options.src);
---

<ImageReact
  src={image.src}
  class={props.class ?? undefined}
  blurDataUrl={blurDataUrl}
  width={image.attributes.width}
  height={image.attributes.height}
  {...image.attributes}
  client:idle
/>
