---
import type { HTMLAttributes } from 'astro/types'

type Props = Omit<HTMLAttributes<'img'>, 'style'> & {
  /** 読み込みを待つあいだ敷いておくぼかしの data URL */
  placeholder?: string
}

const { placeholder, ...attrs } = Astro.props

const placeholderAttrs = placeholder
  ? {
      'data-blurhash': true,
      style: `background-image:url(${placeholder});background-size:cover;background-position:50% 50%`,
    }
  : {}
---

<img {...attrs} {...placeholderAttrs} />

<script>
  import "~/components/image/blurhash_placeholder";
</script>
