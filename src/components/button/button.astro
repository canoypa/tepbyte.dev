---
import type { HTMLTag, Polymorphic } from 'astro/types'
import { css, cva } from '~pandacss/css'

const styles = {
  root: cva({
    base: {
      display: 'inline-flex',
      alignItems: 'center',
      justifyContent: 'center',
      columnGap: 'md.space100',
      paddingX: 'md.space200',
      minWidth: 48,
      height: 40,
      rounded: 'md.full',
      textStyle: 'md.label-large',
      fontFamily: 'comfortaa',
      position: 'relative',
      color: 'md.on-secondary-container',
      fill: 'md.on-secondary-container',
      backgroundColor: 'md.secondary-container',

      // 状態レイヤーはコンテナの色の上に重ねる。中身はその上に出す
      _before: {
        content: '""',
        position: 'absolute',
        inset: 0,
        rounded: 'inherit',
        pointerEvents: 'none',
      },
      '& > *': { position: 'relative' },

      // M3 は hover で elevation level1 の影を付けるが、影があると安っぽく見えるので付けない
      _hover: {
        _before: { backgroundColor: 'md.on-secondary-container/md.hover' },
      },
      _focusVisible: {
        _before: { backgroundColor: 'md.on-secondary-container/md.focus' },
      },
      _active: {
        _before: { backgroundColor: 'md.on-secondary-container/md.pressed' },
      },
    },
    variants: {
      withIcon: {
        true: { paddingX: 'md.space200' },
      },
    },
  }),
  leading: css({
    width: 18,
    height: 18,
  }),
  trailing: css({
    width: 18,
    height: 18,
  }),
}

type Props<T extends HTMLTag> = Polymorphic<{
  as: T
}>

const { as: Tag = 'button', ...attrs } = Astro.props

const hasLeading = Astro.slots.has('leading')
const hasTrailing = Astro.slots.has('trailing')
---

<Tag
  {...attrs}
  class:list={styles.root({ withIcon: Boolean(hasLeading || hasTrailing) })}
>
  {
    hasLeading && (
      <span class:list={styles.leading}>
        <slot name="leading" />
      </span>
    )
  }
  <span>
    <slot />
  </span>
  {
    hasTrailing && (
      <span class:list={styles.trailing}>
        <slot name="trailing" />
      </span>
    )
  }
</Tag>
