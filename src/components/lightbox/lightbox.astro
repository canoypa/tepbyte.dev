---
import './lightbox.css'
import IconButton from '~/components/icon_button/icon_button.astro'
import IconClose from '~/components/icons/close.astro'
import { blurhashPlaceholderStyle } from '~/core/blurhash'
import { css } from '~pandacss/css'
import { flex } from '~pandacss/patterns'

type Props = {
  src: string
  srcSet?: string
  alt?: string
  /** 幅 / 高さ */
  ratio: number
  /** 元画像より大きく引き伸ばさないための上限 px */
  maxWidth: number
  /** 読み込みを待つあいだ敷いておく背景 */
  placeholder?: string
}

const { src, srcSet, alt, ratio, maxWidth, placeholder } = Astro.props

const hasCaption = Astro.slots.has('caption')

const id = `lightbox-${crypto.randomUUID().slice(0, 8)}`

// focus ring の丸みは中身の画像しだいなので、ボタンではなく画像に出す
const bareButton = {
  display: 'inline-flex',
  padding: 0,
  background: 'none',
  border: 'none',
  _focusVisible: { outline: 'none' },
  '&:focus-visible > *': {
    outlineWidth: 2,
    outlineStyle: 'solid',
    outlineColor: { base: 'dark.primary', _osLight: 'light.primary' },
    outlineOffset: 2,
  },
} as const

const styles = {
  trigger: css({ ...bareButton, cursor: 'zoom-in' }),
  dialog: css({
    _open: {
      display: 'grid',
      // 余っている側からボタンの場所を取る。縦長の画面は縦に、横長の画面は横に余る
      gridTemplate: '"close" auto "image" minmax(0, 1fr) / minmax(0, 1fr)',
      placeItems: 'center',

      '@media (orientation: landscape)': {
        gridTemplate: '"close image" minmax(0, 1fr) / 48px minmax(0, 1fr)',
      },
      position: 'fixed',
      inset: 0,
      margin: 0,
      padding: 12,
      width: '100%',
      maxWidth: 'none',
      height: '100%',
      maxHeight: 'none',
      backgroundColor: 'transparent',
      border: 'none',

      _backdrop: {
        backgroundColor: {
          base: 'dark.scrim/64',
          _osLight: 'light.scrim/64',
        },
        backdropFilter: 'blur(4px)',
      },
    },
  }),
  figure: flex({
    gridArea: 'image',
    direction: 'column',
    justifyContent: 'center',
    // 縦長の写真はキャプションより狭く、stretch のままだと左に寄る
    alignItems: 'center',
    // 写真の横に空く余白は scrim として扱う
    pointerEvents: 'none',
    '& > *': { pointerEvents: 'auto' },
    rowGap: 8,
    minHeight: 0,
    maxWidth: '100%',
    maxHeight: '100%',
  }),
  close: css({ gridArea: 'close', placeSelf: 'start start' }),
  image: css({
    minHeight: 0,
    maxWidth: '100%',
    maxHeight: '100%',
    width: 'auto',
    height: 'auto',
    objectFit: 'contain',
    rounded: 'extra-small',
    cursor: 'zoom-out',
  }),
  caption: css({
    minHeight: 24,
    textAlign: 'center',
    textStyle: 'label-medium',
    color: { base: 'dark.on-surface', _osLight: 'light.on-surface' },
  }),
}

// 属性の幅・高さが無いと、読み込み前の画像は 0 になり、レイアウトが決まらない
const width = maxWidth
const height = Math.round(maxWidth / ratio)
---

<button
  type="button"
  command="show-modal"
  commandfor={id}
  aria-label={alt ? undefined : '画像を拡大表示'}
  class:list={styles.trigger}
>
  <slot name="trigger" />
</button>

<dialog
  id={id}
  data-lightbox
  class:list={styles.dialog}
>
  <IconButton
    command="close"
    commandfor={id}
    aria-label="閉じる"
    class:list={styles.close}
  >
    <IconClose />
  </IconButton>

  <figure class:list={styles.figure}>
    <img
      src={src}
      srcset={srcSet}
      sizes="90vw"
      alt={alt}
      width={width}
      height={height}
      loading="lazy"
      data-blurhash={placeholder ? true : undefined}
      class:list={styles.image}
      style={placeholder ? blurhashPlaceholderStyle(placeholder) : undefined}
    />
    {
      hasCaption && (
        <figcaption class:list={styles.caption}>
          <slot name="caption" />
        </figcaption>
      )
    }
  </figure>
</dialog>

<script>
  import "~/components/image/blurhash_placeholder";
  import "~/components/lightbox/close_transition";
</script>
