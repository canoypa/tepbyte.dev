---
import './lightbox.css'
import IconButton from '~/components/icon_button/icon_button.astro'
import IconClose from '~/components/icons/close.astro'
import { css } from '~pandacss/css'
import { flex } from '~pandacss/patterns'

type Props = {
  /** LightboxTrigger から開くときに指す id */
  id: string
  /** 拡大画像を表示する最大の幅と高さ（px） */
  width: number
  height: number
}

const { id, width, height } = Astro.props

const hasCaption = Astro.slots.has('caption')

const styles = {
  dialog: css({
    _open: {
      display: 'grid',
      // 余っている側からボタンの場所を取る。縦長の画面は縦に、横長の画面は横に余る。
      // 反対側にも同じ幅を空けて、画像を画面の中央に置く。40 は IconButton の大きさ
      gridTemplate:
        '"close" 40px "image" minmax(0, 1fr) "." 40px / minmax(0, 1fr)',
      placeItems: 'center',
      gap: 'md.space150',

      '@media (orientation: landscape)': {
        gridTemplate:
          '"close image ." minmax(0, 1fr) / 40px minmax(0, 1fr) 40px',
      },
      position: 'fixed',
      inset: 0,
      margin: 0,
      padding: 'md.space150',
      width: '100%',
      maxWidth: 'none',
      height: '100%',
      maxHeight: 'none',
      backgroundColor: 'transparent',
      border: 'none',

      _backdrop: {
        backgroundColor: 'md.scrim/64',
        backdropFilter: 'blur(4px)',
      },
    },
  }),
  figure: flex({
    gridArea: 'image',
    direction: 'column',
    justifyContent: 'center',
    // 縦長の写真はキャプションより狭く、stretch のままだと左に寄る
    alignItems: 'center',
    // 写真の横に空く余白は scrim として扱う
    pointerEvents: 'none',
    '& > *': { pointerEvents: 'auto' },
    rowGap: 'md.space100',
    containerType: 'size',
    width: '100%',
    height: '100%',

    // 読み込み前の画像には自然な大きさが無い。高さを最大の高さから flex で縮めて決め、
    // 幅は縦横比から決める。幅で収まるときの高さは、領域の幅と縦横比から抑える
    '& > img': {
      minHeight: 0,
      maxWidth: '100%',
      height: 'calc(var(--lightbox-height) * 1px)',
      maxHeight:
        'min(100%, calc(100cqw * var(--lightbox-height) / var(--lightbox-width)))',
      width: 'auto',
      objectFit: 'contain',
      rounded: 'md.extra-small',
      cursor: 'zoom-out',
    },
  }),
  // scrim はテーマによらず黒いので、その上はダーク側の色にする
  close: css.raw({
    gridArea: 'close',
    placeSelf: 'start start',
    fill: 'md.dark.on-surface-variant',
    _hover: { backgroundColor: 'md.dark.on-surface-variant/md.hover' },
    _focusVisible: {
      backgroundColor: 'md.dark.on-surface-variant/md.focus',
      outlineColor: 'md.dark.primary',
    },
    _active: { backgroundColor: 'md.dark.on-surface-variant/md.pressed' },
  }),
  caption: css({
    minHeight: 24,
    textAlign: 'center',
    textStyle: 'md.label-medium',
    color: 'md.dark.on-surface',
  }),
}
---

<dialog
  id={id}
  data-lightbox
  class:list={styles.dialog}
>
  <IconButton
    command="close"
    commandfor={id}
    aria-label="閉じる"
    css={styles.close}
  >
    <IconClose />
  </IconButton>

  <figure class:list={styles.figure} style={`--lightbox-width: ${width}; --lightbox-height: ${height}`}>
    <slot />
    {
      hasCaption && (
        <figcaption class:list={styles.caption}>
          <slot name="caption" />
        </figcaption>
      )
    }
  </figure>
</dialog>

<script>
  import "~/components/lightbox/close_transition";
</script>
