---
import './lightbox.css'
import { blurhashPlaceholderStyle } from '~/core/blurhash'
import { css } from '~pandacss/css'
import { flex } from '~pandacss/patterns'

type Props = {
  src: string
  srcSet?: string
  alt?: string
  /** 幅 / 高さ */
  ratio: number
  /** 元画像より大きく引き伸ばさないための上限 px */
  maxWidth: number
  /** 読み込みを待つあいだ敷いておく背景 */
  placeholder?: string
}

const { src, srcSet, alt, ratio, maxWidth, placeholder } = Astro.props

const hasCaption = Astro.slots.has('caption')

const id = `lightbox-${crypto.randomUUID().slice(0, 8)}`

// focus ring の丸みは中身の画像しだいなので、ボタンから画像へ付け替える
const bareButton = {
  display: 'inline-flex',
  padding: 0,
  background: 'none',
  border: 'none',
  _focusVisible: { outline: 'none' },
  '&:focus-visible > *': {
    outlineWidth: 2,
    outlineStyle: 'solid',
    outlineColor: { base: 'dark.primary', _osLight: 'light.primary' },
    outlineOffset: 2,
  },
} as const

const styles = {
  trigger: css({ ...bareButton, cursor: 'zoom-in' }),
  dialog: css({
    _open: {
      display: 'flex',
      justifyContent: 'center',
      alignItems: 'center',
      margin: 'auto',
      padding: 0,
      width: 'auto',
      maxWidth: '90vw',
      height: 'auto',
      maxHeight: '90vh',
      backgroundColor: 'transparent',
      border: 'none',

      _backdrop: {
        backgroundColor: {
          base: 'dark.scrim/64',
          _osLight: 'light.scrim/64',
        },
        backdropFilter: 'blur(4px)',
      },
    },
  }),
  figure: flex({
    direction: 'column',
    // 縦長の写真はキャプションより狭く、stretch のままだと左に寄る
    alignItems: 'center',
    rowGap: 8,
    maxWidth: '100%',
    maxHeight: '100%',
  }),
  close: css({ ...bareButton, cursor: 'zoom-out' }),
  image: css({
    // width: auto にしない。開いた直後は未ロードで、幅が 0 になる
    width:
      'min(90vw, var(--lightbox-max-width), calc((90vh - var(--lightbox-caption-space, 0px)) * var(--lightbox-ratio)))',
    height: 'auto',
    aspectRatio: 'var(--lightbox-ratio)',
    rounded: 'extra-small',
  }),
  caption: css({
    minHeight: 24,
    textAlign: 'center',
    textStyle: 'label-medium',
    color: { base: 'dark.on-surface', _osLight: 'light.on-surface' },
  }),
}

const imageStyle = [
  `--lightbox-ratio:${ratio}`,
  `--lightbox-max-width:${maxWidth}px`,
  hasCaption ? '--lightbox-caption-space:32px' : '',
  placeholder ? blurhashPlaceholderStyle(placeholder) : '',
]
  .filter(Boolean)
  .join(';')
---

<button
  type="button"
  command="show-modal"
  commandfor={id}
  aria-label={alt ? undefined : '画像を拡大表示'}
  class:list={styles.trigger}
>
  <slot name="trigger" />
</button>

<dialog
  id={id}
  data-lightbox
  class:list={styles.dialog}
>
  <figure class:list={styles.figure}>
    <button
      type="button"
      command="close"
      commandfor={id}
      aria-label="閉じる"
      class:list={styles.close}
    >
      <img
        src={src}
        srcset={srcSet}
        sizes="90vw"
        alt={alt}
        loading="lazy"
        data-blurhash={placeholder ? true : undefined}
        class:list={styles.image}
        style={imageStyle}
      />
    </button>
    {
      hasCaption && (
        <figcaption class:list={styles.caption}>
          <slot name="caption" />
        </figcaption>
      )
    }
  </figure>
</dialog>

<script>
  import "~/components/image/blurhash_placeholder";
  import "~/components/lightbox/close_transition";
</script>
