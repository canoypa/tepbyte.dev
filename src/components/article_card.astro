---
import { css } from '~pandacss/css'
import StyledLink from './styled_link/styled_link.astro'

const styles = {
  time: css({
    textStyle: 'md.label-medium',
  }),
  title: css({
    textStyle: 'md.title-medium',
  }),
  subhead: css({ lineClamp: 2 }),
}

// ビルドは UTC で走る。日本時間の朝に公開した記事が前日の日付にならないようにする
const dateFormatter = Intl.DateTimeFormat('en-us', {
  dateStyle: 'long',
  timeZone: 'Asia/Tokyo',
})

type Props = {
  date: Date
  link: URL | string
  title: string
  subhead: string
  /** subhead を 2 行で省略する */
  clampSubhead?: boolean
}

const { date, link, title, subhead, clampSubhead } = Astro.props
---

<article>
  <p class:list={styles.time}>
    <time datetime={date.toISOString()}>
      {dateFormatter.format(date)}
    </time>
  </p>
  <h3>
    <StyledLink href={link} class:list={styles.title}>
      {title}
    </StyledLink>
  </h3>
  <p class:list={[clampSubhead && styles.subhead]}>{subhead}</p>
</article>
