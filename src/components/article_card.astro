---
import { css } from '~pandacss/css'
import DateTime from './date_time.astro'
import StyledLink from './styled_link/styled_link.astro'

const styles = {
  time: css({
    textStyle: 'md.label-medium',
  }),
  title: css({
    textStyle: 'md.title-medium',
  }),
  subhead: css({ lineClamp: 2 }),
}

type Props = {
  date: Date
  datePrecision: 'date' | 'datetime'
  link: URL | string
  title: string
  subhead: string
  /** subhead を 2 行で省略する */
  clampSubhead?: boolean
  headingLevel: 2 | 3
}

const {
  date,
  datePrecision,
  link,
  title,
  subhead,
  clampSubhead,
  headingLevel,
} = Astro.props

const Heading = `h${headingLevel}` as const
---

<article>
  <p class:list={styles.time}>
    <DateTime date={date} precision={datePrecision} />
  </p>
  <Heading>
    <StyledLink href={link} class:list={styles.title}>
      {title}
    </StyledLink>
  </Heading>
  <p class:list={[clampSubhead && styles.subhead]}>{subhead}</p>
</article>
